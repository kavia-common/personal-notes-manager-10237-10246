# Base URL of backend REST API (e.g. http://localhost:4000 or https://api.example.com)
VITE_API_BASE_URL=http://localhost:4000

# Optional: whether to send credentials (cookies) with fetch requests to API
VITE_API_WITH_CREDENTIALS=false

# Optional: site URL used for redirects in auth emails (if using email links)
VITE_SITE_URL=http://localhost:3000
